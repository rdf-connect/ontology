    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- http://www.w3.org/ns/prov#SoftwareAgent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#SoftwareAgent"/>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person"/>
    


    <!-- https://w3id.org/rdf-connect#CommandRunner -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#CommandRunner">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rdf-connect#Runner"/>
        <rdfs:comment xml:lang="en">A runner that executes processors via shell commands.</rdfs:comment>
        <rdfs:label xml:lang="en">Command Runner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#ExecutionContext -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#ExecutionContext">
        <rdfs:comment xml:lang="en">Entity that defines an execution context used by a pipeline, which is composed by a runner and a set of processor instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Execution Context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Pipeline -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Pipeline">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A sequence of processors and runners forming a data processing workflow.</rdfs:comment>
        <rdfs:label xml:lang="en">Pipeline</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Processor -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Processor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A processing unit that performs an action within a pipeline.</rdfs:comment>
        <rdfs:label xml:lang="en">Processor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Reader -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Reader">
        <rdfs:comment xml:lang="en">A component that provides input data to a processor.</rdfs:comment>
        <rdfs:label xml:lang="en">Reader</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Runner -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Runner">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
        <rdfs:comment xml:lang="en">An agent responsible for executing processors based on specific implementations.</rdfs:comment>
        <rdfs:label xml:lang="en">Runner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Writer -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Writer">
        <rdfs:comment xml:lang="en">A component that handles output data from a processor.</rdfs:comment>
        <rdfs:label xml:lang="en">Writer</rdfs:label>
    </owl:Class>
</rdf:RDF>



