    <owl:ObjectProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    


    <!-- https://w3id.org/rdf-connect#consistsOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#consistsOf">
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#Pipeline"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#ExecutionContext"/>
        <rdfs:comment xml:lang="en">Relates a pipeline to an execution context (runner and processors) it uses.</rdfs:comment>
        <rdfs:label xml:lang="en">consists of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#handlesSubjectsOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#handlesSubjectsOf">
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#Runner"/>
        <rdfs:comment xml:lang="en">The property that defines which type of processors a runner can handle, typically linked to a specific implementation property.</rdfs:comment>
        <rdfs:label xml:lang="en">handle subjects of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#implementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#implementationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#Processor"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#Processor"/>
        <rdfs:comment xml:lang="en">Abstract property that conveys the implementation language of a processor.</rdfs:comment>
        <rdfs:label xml:lang="en">implementation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#instantiates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#instantiates">
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#ExecutionContext"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#Runner"/>
        <rdfs:comment xml:lang="en">Declares the runner instance used in an execution context.</rdfs:comment>
        <rdfs:label xml:lang="en">instantiates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#javaImplementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#javaImplementationOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rdf-connect#implementationOf"/>
        <rdfs:comment xml:lang="en">Indicates that a processor is implemented in Java and is a specialization of implementationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Java Implementation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#jsImplementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#jsImplementationOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rdf-connect#implementationOf"/>
        <rdfs:comment xml:lang="en">Indicates that a processor is implemented in JavaScript and is a specialization of implementationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">JavaScript Implementation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#processor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#processor">
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#ExecutionContext"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#Processor"/>
        <rdfs:comment xml:lang="en">Declares a processor instance used in an execution context, part of a pipeline.</rdfs:comment>
        <rdfs:label xml:lang="en">processor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#pyImplementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#pyImplementationOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rdf-connect#implementationOf"/>
        <rdfs:comment xml:lang="en">Indicates that a processor is implemented in Python and is a specialization of implementationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Python Implementation Of</rdfs:label>
    </owl:ObjectProperty>
    


