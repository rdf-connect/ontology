    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- http://www.w3.org/ns/prov#ActivityInfluence -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#ActivityInfluence"/>
    


    <!-- http://www.w3.org/ns/prov#Association -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Association"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- http://www.w3.org/ns/prov#Plan -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Plan"/>
    


    <!-- http://www.w3.org/ns/prov#SoftwareAgent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#SoftwareAgent"/>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person"/>
    


    <!-- https://w3id.org/rdf-connect#CommandRunner -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#CommandRunner">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rdf-connect#Runner"/>
        <rdfs:comment xml:lang="en">A runner that executes processors via shell commands.</rdfs:comment>
        <rdfs:label xml:lang="en">Command Runner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#ExecutionContext -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#ExecutionContext">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#ActivityInfluence"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Association"/>
        <rdfs:comment xml:lang="en">A qualified association that binds a runner (agent) to the processor instances (activities) it executes within a pipeline, and to the pipeline plan itself. As a subclass of prov:Association it qualifies the assignment of responsibility for those processors to their runner, and as a subclass of prov:ActivityInfluence it cites those processors directly with prov:activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Execution Context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Pipeline -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Pipeline">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Plan"/>
        <rdfs:comment xml:lang="en">A plan specifying a sequence of processors and runners forming a data processing workflow. As a subclass of prov:Plan, a pipeline represents the set of steps intended by agents and executed to achieve data processing goals.</rdfs:comment>
        <rdfs:label xml:lang="en">Pipeline</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Processor -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Processor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A processing unit that performs an action within a pipeline. As a subclass of prov:Activity, a processor is a concrete data processing action occurring over time, consuming input entities and producing output entities.</rdfs:comment>
        <rdfs:label xml:lang="en">Processor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Reader -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Reader">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A data channel entity that provides input data to a processor. As a subclass of prov:Entity, a reader is a data artifact that is consumed (prov:used) by a processor activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Reader</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Runner -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Runner">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
        <rdfs:comment xml:lang="en">An agent responsible for executing processors based on specific implementations. As a subclass of prov:SoftwareAgent, a runner is a non-human agent implemented in software that bears responsibility for executing processor activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Runner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rdf-connect#Writer -->


    <owl:Class rdf:about="https://w3id.org/rdf-connect#Writer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A data channel entity that handles output data from a processor. As a subclass of prov:Entity, a writer is a data artifact generated (prov:wasGeneratedBy) by a processor activity and consumed by downstream processors.</rdfs:comment>
        <rdfs:label xml:lang="en">Writer</rdfs:label>
    </owl:Class>
</rdf:RDF>



