    <!-- http://www.w3.org/2000/01/rdf-schema#subClassOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    


    <!-- http://www.w3.org/ns/prov#activity -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#activity"/>
    


    <!-- http://www.w3.org/ns/prov#agent -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#agent"/>
    


    <!-- http://www.w3.org/ns/prov#hadPlan -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#hadPlan"/>
    


    <!-- https://w3id.org/rdf-connect#consistsOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#consistsOf">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#hadPlan"/>
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#Pipeline"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#ExecutionContext"/>
        <rdfs:comment xml:lang="en">Relates a pipeline plan to the execution contexts (qualified runner–processor associations), and is declared as the inverse of prov:hadPlan. Because prov:hadPlan goes from a prov:Association to the prov:Plan it follows, each execution context (Association) thereby records the pipeline plan (Plan) it follows, matching the PROV-O qualified-association pattern.</rdfs:comment>
        <rdfs:label xml:lang="en">consists of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#handlesSubjectsOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#handlesSubjectsOf">
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#Runner"/>
        <rdfs:comment xml:lang="en">The property that defines which type of processors a runner can handle, typically linked to a specific implementation property.</rdfs:comment>
        <rdfs:label xml:lang="en">handle subjects of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#implementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#implementationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#Processor"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#Processor"/>
        <rdfs:comment xml:lang="en">Abstract property that conveys the implementation language of a processor. As a subproperty of rdfs:subClassOf, any processor definition declared with rdfc:implementationOf rdfc:Processor is itself a subclass of rdfc:Processor.</rdfs:comment>
        <rdfs:label xml:lang="en">implementation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#instantiates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#instantiates">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#agent"/>
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#ExecutionContext"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#Runner"/>
        <rdfs:comment xml:lang="en">Declares the runner instance (agent) used in an execution context. As a subproperty of prov:agent, it identifies the Runner (prov:SoftwareAgent) responsible for executing the pipeline&apos;s processors within an ExecutionContext (prov:Association).</rdfs:comment>
        <rdfs:label xml:lang="en">instantiates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#javaImplementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#javaImplementationOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rdf-connect#implementationOf"/>
        <rdfs:comment xml:lang="en">Indicates that a processor is implemented in Java and is a specialization of implementationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Java Implementation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#jsImplementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#jsImplementationOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rdf-connect#implementationOf"/>
        <rdfs:comment xml:lang="en">Indicates that a processor is implemented in JavaScript and is a specialization of implementationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">JavaScript Implementation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#processor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#processor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#activity"/>
        <rdfs:domain rdf:resource="https://w3id.org/rdf-connect#ExecutionContext"/>
        <rdfs:range rdf:resource="https://w3id.org/rdf-connect#Processor"/>
        <rdfs:comment xml:lang="en">Declares a processor instance (activity) used in an execution context, part of a pipeline. As a subproperty of prov:activity, it identifies the Processor instances (prov:Activity) the runner is responsible for executing within an ExecutionContext (prov:Association, prov:ActivityInfluence).</rdfs:comment>
        <rdfs:label xml:lang="en">processor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rdf-connect#pyImplementationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rdf-connect#pyImplementationOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rdf-connect#implementationOf"/>
        <rdfs:comment xml:lang="en">Indicates that a processor is implemented in Python and is a specialization of implementationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Python Implementation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/rdf-connect#class -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#class">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The class name of a processor. Applicable for any object-oriented programming language.</rdfs:comment>
        <rdfs:label xml:lang="en">class</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rdf-connect#command -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#command">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Shell command used by an orchestrator to execute a runner instance.</rdfs:comment>
        <rdfs:label xml:lang="en">command</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rdf-connect#entrypoint -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#entrypoint">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">The folder location of the main script or module entry point of a JavaScript processor.</rdfs:comment>
        <rdfs:label xml:lang="en">entrypoint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rdf-connect#file -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#file">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">The file name containing the processor logic of a JavaScript processor.</rdfs:comment>
        <rdfs:label xml:lang="en">file</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rdf-connect#jar -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#jar">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Path to the JAR file containing the processor logic of a Java processor.</rdfs:comment>
        <rdfs:label xml:lang="en">jar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rdf-connect#logLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#logLevel">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rdf-connect#Reader"/>
                    <rdf:Description rdf:about="https://w3id.org/rdf-connect#Writer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Optional level at which an orchestrator logs the data crossing a channel, such as info or debug. It is an aid while developing or inspecting a pipeline and has no effect on how messages are routed or delivered. Its domain is the union of rdfc:Reader and rdfc:Writer, since either end of a channel may declare it.</rdfs:comment>
        <rdfs:label xml:lang="en">log level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rdf-connect#module_path -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rdf-connect#module_path">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The module path of a processor implemented in Python.</rdfs:comment>
        <rdfs:label xml:lang="en">module path</rdfs:label>
    </owl:DatatypeProperty>
    


