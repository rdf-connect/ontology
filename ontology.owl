    <owl:Ontology rdf:about="https://w3id.org/rdf-connect#">
        <ns:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:author rdf:nodeID="genid1"/>
        <terms:contributor rdf:resource="https://julianrojas.org/#me"/>
        <terms:contributor rdf:resource="https://pietercolpaert.be/#me"/>
        <terms:contributor rdf:resource="https://smessaert.be/#me"/>
        <terms:contributor rdf:nodeID="genid2"/>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-29</terms:issued>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-17</terms:modified>
        <vann:preferredNamespacePrefix>rdfc</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/rdf-connect#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">An ontology for describing programming language-specific runners, processors and pipelines in RDF-based data processing frameworks.</rdfs:comment>
        <rdfs:label xml:lang="en">RDF-Connect Ontology</rdfs:label>
        <owl:versionInfo>0.4.0</owl:versionInfo>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>Arthur Vercruysse</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>Jens Pots</foaf:name>
    </rdf:Description>
    


