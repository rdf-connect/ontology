@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix cc: <http://creativecommons.org/ns#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.

#################################################################
# Ontology metadata
#################################################################
<https://w3id.org/rdf-connect/ontology> a owl:Ontology;
  cc:license <https://creativecommons.org/licenses/by/4.0/>;
  dct:author [
    a foaf:Person;
    foaf:name "Arthur Vercruysse";
  ];
  dct:contributor [
    a foaf:Person;
    foaf:name "Jens Pots";
  ],
    <https://julianrojas.org/#me>,
    <https://pietercolpaert.be/#me>,
    <https://smessaert.be/#me>;
  dct:issued "2024-07-29"^^xsd:date;
  dct:modified "2026-06-15"^^xsd:date;
  rdfs:label "RDF-Connect Ontology"@en;
  rdfs:comment "An ontology for describing programming language-specific runners, processors and pipelines in RDF-based data processing frameworks."@en;
  owl:versionInfo "0.3.0".

#################################################################
# Classes
#################################################################

# rdfc:Processor is a prov:Activity: it is a concrete data processing action that occurs over time,
# consuming input entities and producing output entities, in line with the PROV-O definition of prov:Activity.
rdfc:Processor a owl:Class;
  rdfs:subClassOf prov:Activity;
  rdfs:label "Processor"@en;
  rdfs:comment "A processing unit that performs an action within a pipeline."@en.

# rdfc:Runner is a prov:SoftwareAgent: it bears responsibility for the execution of processor activities,
# matching the PROV-O definition of prov:SoftwareAgent as a non-human agent implemented in software.
rdfc:Runner a owl:Class;
  rdfs:subClassOf prov:SoftwareAgent;
  rdfs:label "Runner"@en;
  rdfs:comment "An agent responsible for executing processors based on specific implementations."@en.

# rdfc:Pipeline is a prov:Plan: a pipeline is a specification of a set of processing steps (processors and runners)
# intended by agents to achieve data processing goals, which matches the PROV-O definition of prov:Plan
# ("an entity that represents a set of actions or steps intended by one or more agents to achieve some goals").
# prov:Plan is itself a subclass of prov:Entity.
rdfc:Pipeline a owl:Class;
  rdfs:subClassOf prov:Plan;
  rdfs:label "Pipeline"@en;
  rdfs:comment "A plan specifying a sequence of processors and runners forming a data processing workflow."@en.

# rdfc:ExecutionContext is a prov:Association: it qualifies the relationship between a pipeline execution and
# a runner (agent), specifying which processor instances (activities) that runner is responsible for executing.
rdfc:ExecutionContext a owl:Class;
  rdfs:subClassOf prov:Association;
  rdfs:label "Execution Context"@en;
  rdfs:comment "A qualified association that binds a runner (agent) to the set of processor instances (activities) it executes within a pipeline, and to the pipeline plan itself."@en.

# rdfc:Reader is a prov:Entity: a reader channel is a data artifact with fixed aspects (the data stream it carries)
# that is consumed (prov:used) by a processor activity.
rdfc:Reader a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "Reader"@en;
  rdfs:comment "A data channel entity that provides input data to a processor."@en.

# rdfc:Writer is a prov:Entity: a writer channel is a data artifact generated (prov:wasGeneratedBy) by a processor
# activity and subsequently consumed by downstream processors.
rdfc:Writer a owl:Class;
  rdfs:subClassOf prov:Entity;
  rdfs:label "Writer"@en;
  rdfs:comment "A data channel entity that handles output data from a processor."@en.

rdfc:CommandRunner a owl:Class;
  rdfs:subClassOf rdfc:Runner;
  rdfs:label "Command Runner"@en;
  rdfs:comment "A runner that executes processors via shell commands."@en.

#################################################################
# Properties
#################################################################

# rdfc:implementationOf is a subproperty of rdfs:subClassOf because declaring that a concrete processor
# "is an implementation of" an abstract processor makes the concrete class a specialisation in the RDFS class hierarchy.
rdfc:implementationOf a owl:ObjectProperty;
  rdfs:subPropertyOf rdfs:subClassOf;
  rdfs:label "implementation of"@en;
  rdfs:comment "Abstract property that conveys the implementation language of a processor."@en;
  rdfs:domain rdfc:Processor;
  rdfs:range rdfc:Processor.

rdfc:handlesSubjectsOf a owl:ObjectProperty;
  rdfs:label "handle subjects of"@en;
  rdfs:comment "The property that defines which type of processors a runner can handle, typically linked to a specific implementation property."@en;
  rdfs:domain rdfc:Runner.

# rdfc:consistsOf is the owl:inverseOf prov:hadPlan: in PROV-O, prov:hadPlan goes from a prov:Association to the
# prov:Plan it follows. rdfc:consistsOf goes in the opposite direction (Pipeline/Plan → ExecutionContext/Association),
# so declaring it the inverse of prov:hadPlan makes every
#   <pipeline> rdfc:consistsOf [ec]
# triple entail
#   [ec] prov:hadPlan <pipeline>
# which is exactly the PROV-O qualified-association pattern: the execution
# context (Association) records which plan (Pipeline) it executes.
rdfc:consistsOf a owl:ObjectProperty;
  owl:inverseOf prov:hadPlan;
  rdfs:label "consists of"@en;
  rdfs:comment "Relates a pipeline plan to the execution contexts (qualified runner–processor associations) it is composed of. Inverse of prov:hadPlan: each execution context thereby records the pipeline plan it follows."@en;
  rdfs:domain rdfc:Pipeline;
  rdfs:range rdfc:ExecutionContext.

# rdfc:instantiates is a subproperty of prov:agent: within an ExecutionContext (prov:Association), rdfc:instantiates
# points to the Runner (prov:SoftwareAgent) that is responsible for executing the pipeline's processors, exactly as
# prov:agent identifies the agent involved in a qualified association.
rdfc:instantiates a owl:ObjectProperty;
  rdfs:subPropertyOf prov:agent;
  rdfs:label "instantiates"@en;
  rdfs:comment "Declares the runner instance (agent) used in an execution context."@en;
  rdfs:domain rdfc:ExecutionContext;
  rdfs:range rdfc:Runner.

# rdfc:processor is a subproperty of prov:activity: within an ExecutionContext (prov:Association), rdfc:processor points
# to the Processor instances (prov:Activity) the runner is responsible for executing, mirroring the use of prov:activity
# to identify the activity involved in a qualified association.
rdfc:processor a owl:ObjectProperty;
  rdfs:subPropertyOf prov:activity;
  rdfs:label "processor"@en;
  rdfs:comment "Declares a processor instance (activity) used in an execution context, part of a pipeline."@en;
  rdfs:domain rdfc:ExecutionContext;
  rdfs:range rdfc:Processor.

rdfc:command a owl:DatatypeProperty;
  rdfs:label "command"@en;
  rdfs:comment "Shell command used by an orchestrator to execute a runner instance."@en;
  rdfs:range xsd:string.

rdfc:class a owl:DatatypeProperty;
  rdfs:label "class"@en;
  rdfs:comment "The class name of a processor. Applicable for any object-oriented programming language."@en;
  rdfs:range xsd:string.

#################################################################
# JavaScript-specific Properties
#################################################################

rdfc:jsImplementationOf a owl:ObjectProperty;
  rdfs:label "JavaScript Implementation Of"@en;
  rdfs:comment "Indicates that a processor is implemented in JavaScript and is a specialization of implementationOf."@en;
  rdfs:subPropertyOf rdfc:implementationOf.

rdfc:entrypoint a owl:DatatypeProperty;
  rdfs:label "entrypoint"@en;
  rdfs:comment "The folder location of the main script or module entry point of a JavaScript processor."@en;
  rdfs:range xsd:anyURI.

rdfc:file a owl:DatatypeProperty;
  rdfs:label "file"@en;
  rdfs:comment "The file name containing the processor logic of a JavaScript processor."@en;
  rdfs:range xsd:anyURI.

#################################################################
# Java-specific Properties
#################################################################

rdfc:javaImplementationOf a owl:ObjectProperty;
  rdfs:label "Java Implementation Of"@en;
  rdfs:comment "Indicates that a processor is implemented in Java and is a specialization of implementationOf."@en;
  rdfs:subPropertyOf rdfc:implementationOf.

rdfc:jar a owl:DatatypeProperty;
  rdfs:label "jar"@en;
  rdfs:comment "Path to the JAR file containing the processor logic of a Java processor."@en;
  rdfs:range xsd:anyURI.

#################################################################
# Python-specific Properties
#################################################################

rdfc:pyImplementationOf a owl:ObjectProperty;
  rdfs:label "Python Implementation Of"@en;
  rdfs:comment "Indicates that a processor is implemented in Python and is a specialization of implementationOf."@en;
  rdfs:subPropertyOf rdfc:implementationOf.

rdfc:module_path a owl:DatatypeProperty;
  rdfs:label "module path"@en;
  rdfs:comment "The module path of a processor implemented in Python."@en;
  rdfs:range xsd:string.
