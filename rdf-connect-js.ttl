@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix cc: <http://creativecommons.org/ns#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfc-js: <https://w3id.org/rdf-connect/js#>.

rdfc:NodeRunner a owl:Class;
  rdfs:label "Node Runner"@en;
  rdfs:comment "A specialized runner that executes JavaScript-based processors using Node.js."@en;
  rdfs:subClassOf rdfc:Runner.

rdfc:jsImplementationOf a owl:ObjectProperty;
  rdfs:label "JavaScript Implementation Of"@en;
  rdfs:comment "Indicates that a processor is implemented in JavaScript and is a specialization of implementationOf."@en;
  rdfs:subPropertyOf <https://w3id.org/sds#implementationOf>.

